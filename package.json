{
  "name": "@voyagier/cli",
  "version": "2.6.2",
  "description": "Agent-ready travel CLI — search, plan, quote, and book real trips (flights, hotels, activities) against the Voyagier platform. Built for AI agents: --json everywhere, uniform error codes, price-gated checkout, printable agent reference (voyagier agent-docs).",
  "type": "module",
  "bin": {
    "voyagier": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage"
  },
  "keywords": [
    "voyagier",
    "travel",
    "travel-booking",
    "flights",
    "hotels",
    "activities",
    "trip-planning",
    "cli",
    "ai",
    "ai-agent",
    "llm",
    "agent-tools",
    "agent-ready",
    "booking",
    "travel-agent"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "graphql": "^16.14.1"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^1.2.1",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENT.md"
  ]
}
